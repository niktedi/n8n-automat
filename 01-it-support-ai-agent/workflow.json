    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Searches the internal support knowledge base for instructions on common problems (n8n down, disk full, container restarting, bot not responding) and on when to open a ticket. Pass the problem keywords in English; translate them if the user wrote in another language.",
        "operation": "executeQuery",
        "query": "WITH q AS (\n  SELECT replace(plainto_tsquery('english', $1)::text, ' & ', ' | ')::tsquery AS query\n)\nSELECT a.title, a.body\nFROM kb.articles a, q\nWHERE a.search @@ q.query\nORDER BY ts_rank(a.search, q.query) DESC\nLIMIT 3;",
        "options": {
          "queryReplacement": "={{ $fromAI('query', 'Problem keywords in English', 'string') }}"
        }
      },
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.7,
