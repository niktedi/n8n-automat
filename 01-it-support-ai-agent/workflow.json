      "name": "server_status"
    },
    {
      "parameters": {
        "jsCode": "// 1. обрезаем до лимита Telegram (4096) ещё ДО разметки, чтобы не разрезать тег\nlet text = ($json.output ?? '').slice(0, 3800);\n\n// 2. экранируем всё, что HTML-парсер Telegram считает разметкой\ntext = text\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\n// 3. переводим частые элементы Markdown в HTML\ntext = text\n  .replace(/```(?:\\w+)?\\n?([\\s\\S]*?)```/g, '<pre>$1</pre>')   // блок кода\n  .replace(/`([^`\\n]+)`/g, '<code>$1</code>')                 // код в строке\n  .replace(/^\\s*[*-] /gm, '• ')                               // пункты списка\n  .replace(/\\*\\*([^*\\n]+)\\*\\*/g, '<b>$1</b>');                // жирный\n\nreturn { json: { text } };;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -176
