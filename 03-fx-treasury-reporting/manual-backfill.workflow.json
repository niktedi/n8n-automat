    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "from datetime import date, timedelta\n\ncfg = _items[0][\"json\"]\nstart = date.fromisoformat(cfg[\"start_date\"])\nend = date.fromisoformat(cfg[\"end_date\"])\nspan = int(cfg[\"window_days\"])\n\nif start > end:\n    raise ValueError(f\"start_date {start} is after end_date {end}\")\n\nwindows = []\ns = start\nwhile s <= end:\n    e = min(s + timedelta(days=span - 1), end)  # inclusive window of at most `span` days\n    windows.append({\"json\": {\"start_date\": s.isoformat(), \"end_date\": e.isoformat()}})\n    s = e + timedelta(days=1)\n\nreturn windows"
      },
