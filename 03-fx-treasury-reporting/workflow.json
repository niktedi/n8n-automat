    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "projectId": {
          "__rl": true,
          "value": "n8n-automat-fx",
          "mode": "list",
          "cachedResultName": "n8n-automat",
          "cachedResultUrl": "https://console.cloud.google.com/bigquery?project=n8n-automat-fx"
        },
        "sqlQuery": "WITH last_day AS (\n  SELECT *\n  FROM `{{ $('Config').first().json.project }}.{{ $('Config').first().json.dataset }}.rate_metrics`\n  WHERE rate_date = (\n    SELECT MAX(rate_date)\n    FROM `{{ $('Config').first().json.project }}.{{ $('Config').first().json.dataset }}.rate_metrics`\n  )\n)\nSELECT\n  rate_date,\n  currency,\n  mid,\n  chg_1d_pct,\n  chg_1w_pct,\n  vol_30d_ann_pct,\n  {{ $('Config').first().json.threshold_pct }}                                  AS threshold_pct,\n  DATE_DIFF(CURRENT_DATE('Europe/Warsaw'), rate_date, DAY)                      AS days_since_last,\n  ABS(chg_1d_pct) >= {{ $('Config').first().json.threshold_pct }}               AS is_move,\n  DATE_DIFF(CURRENT_DATE('Europe/Warsaw'), rate_date, DAY)\n    > {{ $('Config').first().json.stale_days }}                                 AS is_stale\nFROM last_day\nORDER BY currency",
        "options": {
          "maximumBytesBilled": "100000000"
        }
      },
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "position": [
        80,
        -16
      ],
      "id": "cbc75b6f-f084-40ac-8066-b0890fd4aa8f",
      "name": "Check",
      "credentials": {
        "googleApi": {
          "id": "lT4sBge6in3SPKNs",
          "name": "GCP fx"
        }
      }
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "rows = [i[\"json\"] for i in _items]\n\n\ndef flag(value):\n    \"\"\"BigQuery returns booleans as the strings 'true'/'false'.\"\"\"\n    return value is True or str(value).lower() == \"true\"\n\n\nif not rows:\n    return [{\"json\": {\n        \"send\": True,\n        \"text\": \"⚠️ <b>FX check returned no data</b>\\nrate_metrics is empty. Check the BigQuery load.\",\n    }}]\n\nlast_date = rows[0][\"rate_date\"]\nmessages = []\n\nif flag(rows[0][\"is_stale\"]):\n    messages.append(\n        f\"⚠️ <b>FX data is stale</b>\\n\"\n        f\"Last NBP table: {last_date} ({rows[0]['days_since_last']} days ago).\\n\"\n        f\"Check the daily load workflow.\"\n    )\n\nmoves = [r for r in rows if flag(r[\"is_move\"])]\nif moves:\n    lines = []\n    for r in sorted(moves, key=lambda r: abs(float(r[\"chg_1d_pct\"])), reverse=True):\n        d1 = float(r[\"chg_1d_pct\"])\n        w1 = float(r[\"chg_1w_pct\"])\n        arrow = \"🔺\" if d1 > 0 else \"🔻\"\n        lines.append(f\"{arrow} {r['currency']}/PLN {r['mid']}: <b>{d1:+.2f}%</b> d/d, {w1:+.2f}% w/w\")\n    messages.append(\n        f\"📈 <b>FX move alert · {last_date}</b>\\n\"\n        + \"\\n\".join(lines)\n        + f\"\\nThreshold: ±{rows[0]['threshold_pct']}% per day\"\n    )\n\nreturn [{\"json\": {\"send\": bool(messages), \"text\": \"\\n\\n\".join(messages)}}]"
      },
