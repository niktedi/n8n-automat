      "name": "Prepare"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import re\nfrom decimal import Decimal, InvalidOperation\n\nimport json\nimport re\nfrom decimal import Decimal, InvalidOperation\n\nitem = _items[0][\"json\"]\n\n\ndef as_json(value):\n    \"\"\"Fields can arrive as JSON text depending on the Edit Fields type; accept both.\"\"\"\n    return json.loads(value) if isinstance(value, str) else value\n\n\ncfg = as_json(item[\"cfg\"])\ntables = as_json(item[\"tables\"])\n\nDATE = re.compile(r\"\\d{4}-\\d{2}-\\d{2}\")\nTABLE_NO = re.compile(r\"\\d{1,3}/A/NBP/\\d{4}\")\nMID = re.compile(r\"\\d+(\\.\\d+)?\")\n\nif not isinstance(tables, list):\n    raise ValueError(f\"Unexpected NBP response: {str(tables)[:200]}\")\n\nstart, end = cfg[\"start_date\"], cfg[\"end_date\"]\nwanted = set(cfg[\"currencies\"])\nrows = []\n\nfor t in tables:\n    # Validate every value that goes into the SQL text.\n    eff, no = t.get(\"effectiveDate\", \"\"), t.get(\"no\", \"\")\n    if not DATE.fullmatch(eff):\n        raise ValueError(f\"Bad effectiveDate: {eff}\")\n    if not TABLE_NO.fullmatch(no):\n        raise ValueError(f\"Bad table number: {no}\")\n    if not (start <= eff <= end):\n        raise ValueError(f\"Table {no} ({eff}) is outside {start}..{end}\")\n    for r in t.get(\"rates\", []):\n        if r.get(\"code\") not in wanted:\n            continue\n        mid = str(r.get(\"mid\"))\n        try:\n            ok = MID.fullmatch(mid) is not None and Decimal(mid) > 0\n        except InvalidOperation:\n            ok = False\n        if not ok:\n            raise ValueError(f\"Bad rate {r.get('code')} {mid} in {no}\")\n        rows.append({\"rate_date\": eff, \"currency\": r[\"code\"], \"mid\": mid, \"table_no\": no})\n\n# Every published table must contain every currency we track.\nexpected = len(tables) * len(wanted)\nif len(rows) != expected:\n    raise ValueError(f\"Expected {expected} rates ({len(tables)} tables x {len(wanted)}), got {len(rows)}\")\n\nsource = \",\\n    \".join(\n    f\"STRUCT(DATE '{r['rate_date']}' AS rate_date, '{r['currency']}' AS currency, \"\n    f\"NUMERIC '{r['mid']}' AS mid, '{r['table_no']}' AS table_no)\"\n    for r in rows\n)\n\nsql = f\"\"\"MERGE `{cfg['project']}.{cfg['dataset']}.rates` AS T\nUSING (SELECT * FROM UNNEST([\n    {source}\n  ])) AS S\nON  T.rate_date = S.rate_date\nAND T.currency  = S.currency\nAND T.rate_date BETWEEN DATE '{start}' AND DATE '{end}'\nWHEN MATCHED AND (T.mid != S.mid OR T.table_no != S.table_no) THEN\n  UPDATE SET mid = S.mid, table_no = S.table_no, loaded_at = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n  INSERT (rate_date, currency, mid, table_no, loaded_at)\n  VALUES (S.rate_date, S.currency, S.mid, S.table_no, CURRENT_TIMESTAMP())\"\"\"\n\nreturn [{\"json\": {\n    \"sql\": sql,\n    \"start_date\": start,\n    \"end_date\": end,\n    \"tables\": len(tables),\n    \"rows_sent\": len(rows),\n}}]"
      },
